---
interface Props {
  eyebrow: string;
  title?: string;
  align?: 'left' | 'center';
  withAccentLine?: boolean;
  level?: 'h1' | 'h2' | 'h3';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const {
  eyebrow,
  title,
  align = 'left',
  withAccentLine = false,
  level = 'h2',
  size = 'lg',
  class: className = '',
} = Astro.props;

const Heading = level as any;

const sizeClass =
  size === 'sm'
    ? 'text-3xl md:text-4xl'
    : size === 'md'
      ? 'text-4xl md:text-5xl'
      : size === 'xl'
        ? 'text-6xl md:text-7xl lg:text-8xl'
        : 'text-5xl md:text-6xl';

const alignClass = align === 'center' ? 'text-center items-center' : '';
const eyebrowClass = `font-mono text-xs uppercase tracking-[0.2em] text-accent-deep ${
  withAccentLine ? 'pt-3' : ''
}`;
---

<div class={`flex flex-col gap-4 ${alignClass} ${className}`}>
  <p class={eyebrowClass}>{eyebrow}</p>
  {title ? (
    <Heading
      class={`font-serif font-light text-primary tracking-tight leading-[1.05] ${sizeClass}`}
    >
      <slot name="title">{title}</slot>
    </Heading>
  ) : Astro.slots.has('title') ? (
    <Heading
      class={`font-serif font-light text-primary tracking-tight leading-[1.05] ${sizeClass}`}
    >
      <slot name="title" />
    </Heading>
  ) : null}
  <slot />
</div>
