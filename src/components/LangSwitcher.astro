---
import { LOCALES, alternatePath, type Locale } from '../i18n';
import { getDict } from '../i18n';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const dict = getDict(currentLocale);

const LABELS: Record<Locale, { name: string; code: string }> = {
  fr: { name: 'Français', code: 'FR' },
  ht: { name: 'Kreyòl Ayisyen', code: 'HT' },
  en: { name: 'English', code: 'EN' },
};
---

<div class="relative" data-lang-wrapper>
  <button
    type="button"
    data-lang-button
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={dict.lang.label}
    class="flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-primary hover:text-accent-deep transition border border-line rounded-full px-3.5 py-2 hover:border-accent"
  >
    <span>{LABELS[currentLocale].code}</span>
    <svg
      class="w-3 h-3 opacity-60 transition-transform duration-200"
      data-lang-chevron
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"
      />
    </svg>
  </button>

  <div
    data-lang-menu
    role="listbox"
    aria-label={dict.lang.label}
    class="hidden absolute right-0 mt-2 bg-white border border-line shadow-lg rounded-xl min-w-[200px] z-50 overflow-hidden"
  >
    {LOCALES.map((loc, i) => {
      const isCurrent = loc === currentLocale;
      const href = alternatePath(Astro.url, loc);
      return (
        <a
          href={href}
          role="option"
          aria-selected={isCurrent ? 'true' : 'false'}
          hreflang={loc}
          class={`w-full text-left px-4 py-3 hover:bg-surface text-sm flex items-center justify-between gap-4 ${
            i !== 0 ? 'border-t border-line' : ''
          } ${isCurrent ? 'bg-surface/50' : ''}`}
        >
          <span class="text-primary">{LABELS[loc].name}</span>
          <span class="font-mono text-xs text-accent-deep">{LABELS[loc].code}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  function initLangSwitcher() {
    document.querySelectorAll<HTMLElement>('[data-lang-wrapper]').forEach((wrapper) => {
      if (wrapper.dataset.langInit === '1') return;
      wrapper.dataset.langInit = '1';

      const button = wrapper.querySelector<HTMLButtonElement>('[data-lang-button]');
      const menu = wrapper.querySelector<HTMLElement>('[data-lang-menu]');
      const chevron = wrapper.querySelector<HTMLElement>('[data-lang-chevron]');
      if (!button || !menu) return;

      const open = () => {
        menu.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        chevron?.style.setProperty('transform', 'rotate(180deg)');
      };
      const close = () => {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        chevron?.style.setProperty('transform', 'rotate(0deg)');
      };

      button.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        if (isOpen) close();
        else open();
      });

      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target as Node)) close();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });
  }

  initLangSwitcher();
  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
