---
import { type Locale, getDict } from '../i18n';
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';
import Button from './Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const page = dict.pages.lexhaiti;
---

<section class="hero-pattern">
  <Container class="pt-20 md:pt-28 pb-12 md:pb-16">
    <div class="max-w-3xl">
      <SectionHeader
        eyebrow={page.eyebrow}
        title={page.h1}
        level="h1"
        size="xl"
      />
      <p class="mt-8 text-lg md:text-2xl text-primary/75 font-light leading-relaxed max-w-2xl">
        {page.lead}
      </p>
      <div class="mt-10">
        <Button href="https://lexhaiti.org" variant="primary" size="lg" external arrow>
          {page.cta.replace(' →', '')}
        </Button>
      </div>
    </div>
  </Container>
</section>

<section class="border-t border-line bg-white">
  <Container class="py-20 md:py-28">
    <div class="grid md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-4 accent-line pt-3">
          {page.what_title}
        </p>
      </div>
      <div class="md:col-span-8">
        <p class="font-serif text-2xl md:text-3xl leading-snug text-primary font-light">
          {page.what_body}
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-12 gap-12 mt-20 md:mt-28">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-4 accent-line pt-3">
          {page.why_title}
        </p>
      </div>
      <div class="md:col-span-8">
        <p class="text-lg text-primary/80 leading-relaxed">
          {page.why_body}
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-12 gap-12 mt-20 md:mt-28">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-4 accent-line pt-3">
          {page.for_title}
        </p>
      </div>
      <div class="md:col-span-8">
        <p class="text-lg text-primary/80 leading-relaxed">
          {page.for_body}
        </p>
      </div>
    </div>
  </Container>
</section>

<section class="border-t border-line bg-primary text-surface">
  <Container class="py-20 md:py-24">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-12 md:mb-16">
      {page.specs_title}
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      {page.specs.map((s) => (
        <div>
          <p class="font-serif text-5xl md:text-6xl font-light mb-3 leading-none tracking-tight">
            {s.value}
          </p>
          <p class="text-surface/70 text-xs md:text-sm uppercase tracking-wider font-mono">
            {s.label}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>

<section class="border-t border-line bg-surface">
  <Container class="py-20 md:py-24 text-center">
    <Button href="https://lexhaiti.org" variant="primary" size="lg" external arrow>
      lexhaiti.org
    </Button>
  </Container>
</section>
