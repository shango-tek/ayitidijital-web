---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<section class="border-t border-line pt-10 first:border-t-0 first:pt-0">
  <h2 class="font-serif text-2xl md:text-3xl font-medium text-primary mb-4">{title}</h2>
  <p class="text-base md:text-lg text-primary/80 leading-relaxed whitespace-pre-line">
    {body}
  </p>
</section>
