---
import { type Locale, getDict } from '../i18n';
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const page = dict.pages.transparency;
---

<section class="hero-pattern">
  <Container class="pt-20 md:pt-28 pb-12 md:pb-16">
    <div class="max-w-4xl">
      <SectionHeader
        eyebrow={page.eyebrow}
        title={page.h1}
        level="h1"
        size="lg"
      />
      <p class="mt-8 text-lg md:text-xl text-primary/75 font-light max-w-2xl leading-relaxed">
        {page.intro}
      </p>
    </div>
  </Container>
</section>

<section class="border-t border-line bg-white">
  <Container class="py-16 md:py-24 space-y-16 md:space-y-20">
    <article class="grid md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-2">
          01
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-primary mt-2">
          {page.statutes_title}
        </h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-lg text-primary/80 leading-relaxed">
          {page.statutes_body}
        </p>
        <p class="mt-4 font-mono text-sm text-accent-deep">
          {page.statutes_status}
        </p>
      </div>
    </article>

    <article class="grid md:grid-cols-12 gap-8 md:gap-12 border-t border-line pt-16 md:pt-20">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-2">
          02
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-primary mt-2">
          {page.governance_title}
        </h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-lg text-primary/80 leading-relaxed">
          {page.governance_body}
        </p>
      </div>
    </article>

    <article class="grid md:grid-cols-12 gap-8 md:gap-12 border-t border-line pt-16 md:pt-20">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-deep mb-2">
          03
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-primary mt-2">
          {page.finance_title}
        </h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-lg text-primary/80 leading-relaxed">
          {page.finance_body}
        </p>
        <p class="mt-4 font-mono text-sm text-accent-deep">
          {page.annual_report_status}
        </p>
      </div>
    </article>
  </Container>
</section>
