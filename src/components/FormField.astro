---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'number' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  value?: string;
  options?: Array<{ value: string; label: string; selected?: boolean }>;
  rows?: number;
  maxlength?: number;
  autocomplete?: string;
  help?: string;
  readonly?: boolean;
  class?: string;
  spanFull?: boolean;
  pattern?: string;
}

const {
  label,
  name,
  type = 'text',
  required = false,
  placeholder,
  value,
  options,
  rows = 5,
  maxlength,
  autocomplete,
  help,
  readonly = false,
  class: className = '',
  spanFull = false,
  pattern,
} = Astro.props;

const id = `field-${name}`;
const baseInput =
  'w-full bg-white border border-line rounded-xl px-4 py-3 text-sm text-primary placeholder:text-primary/35 focus:border-accent focus:ring-2 focus:ring-accent/30 focus:outline-none transition disabled:opacity-60 disabled:cursor-not-allowed read-only:bg-surface read-only:text-primary/80';
---

<div class={`${spanFull ? 'sm:col-span-2' : ''} ${className}`}>
  <label
    for={id}
    class="block text-sm font-medium text-primary mb-2"
  >
    {label}
    {required && <span class="text-accent-deep ml-1" aria-hidden="true">*</span>}
  </label>

  {type === 'textarea' && (
    <textarea
      id={id}
      name={name}
      rows={rows}
      maxlength={maxlength}
      required={required}
      placeholder={placeholder}
      autocomplete={autocomplete}
      class={`${baseInput} resize-y min-h-[8rem]`}
    >{value ?? ''}</textarea>
  )}

  {type === 'select' && (
    <select
      id={id}
      name={name}
      required={required}
      autocomplete={autocomplete}
      class={baseInput}
    >
      {options?.map((opt) => (
        <option value={opt.value} selected={opt.selected}>{opt.label}</option>
      ))}
    </select>
  )}

  {type !== 'textarea' && type !== 'select' && (
    <input
      id={id}
      name={name}
      type={type}
      required={required}
      placeholder={placeholder}
      value={value}
      autocomplete={autocomplete}
      readonly={readonly}
      maxlength={maxlength}
      pattern={pattern}
      class={baseInput}
    />
  )}

  {help && <p class="mt-2 text-xs text-primary/55 leading-snug">{help}</p>}
</div>
